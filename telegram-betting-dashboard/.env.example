# 不要把真实 api_hash、验证码、两步验证密码或 session 文件发给任何人。
TG_API_ID=填写你自己的_api_id
TG_API_HASH=填写你自己的_api_hash

# 可填群用户名、邀请链接、群标题或 Telethon 可识别的群 ID。
# 留空时，首次启动会列出当前账号可见的群供你选择。
TG_GROUP=

# 强烈建议固定游戏机器人数字 ID，防止群成员伪造“新一期”消息触发下注。
# 留空时程序会从最近消息中查找候选机器人，并要求你在本机确认。
TG_GAME_BOT_ID=

# 回执等待秒数。超过时间仍未收到“下注成功/投注无效”会自动暂停。
TG_ACK_TIMEOUT=10
TG_REPORT_ACCOUNT=@aghaststar
TG_REPORT_CHAT=https://t.me/+_6dhl6VYwjwxZWU9

# v2rayN 本地 SOCKS5/混合端口。留空时会自动检测常见端口。
TG_PROXY_TYPE=socks5
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USER=
TG_PROXY_PASSWORD=

# 本地控制面板端口；只监听 127.0.0.1，不对外公开。
DASHBOARD_PORT=8765

# 可选：也可以留空，在每次启动时手动输入。
# 每期会在 X～Y（含首尾）之间随机选择一个整数金额。
BET_MIN_AMOUNT=
BET_MAX_AMOUNT=

# 累计成功下注金额（总流水）达到或超过此数值时，自动停止后续下注。
BET_STOP_TURNOVER=

# 可选，仅用于让模拟模式显示虚拟余额，不影响总流水停止条件。
BET_START_BALANCE=

